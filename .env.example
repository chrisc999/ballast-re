# Copy to .env (which is gitignored) and fill in. NEVER commit real keys.
# Testnet only. Mainnet keys will be multisig.

# --- Stellar network ---
STELLAR_NETWORK=testnet
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# --- Deployer identity ---
# Preferred: use a stellar-cli identity instead of a raw secret here:
#   stellar keys generate deployer --network testnet --fund
# Then reference it by name in scripts (STELLAR_DEPLOYER_IDENTITY=deployer).
STELLAR_DEPLOYER_IDENTITY=deployer

# If you must use a raw secret (S...), put it here (gitignored). Testnet only.
# STELLAR_DEPLOYER_SECRET=S...

# --- Populated by the deploy script after deployment (do not edit by hand) ---
# TOKEN_CONTRACT_ID=
# VAULT_CONTRACT_ID=
# USDC_SAC_ID=
