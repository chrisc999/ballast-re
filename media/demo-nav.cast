[0.151846, "o", "\r\n════════════════════════════════════════════════════════════\r\n   baUSD  ·  attested NAV, published price, compliance\r\n════════════════════════════════════════════════════════════\r\n"]
[0.152182, "o", "\r\n[1/8]  Fresh LP and treasury accounts, funded with test USDC\r\n"]
